<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.0">
    <persistence-unit name="cmaPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <properties>
            <!-- DRIVER (OBLIGATORIO) -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>

            <!-- CONEXIÓN -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/databaseCMA"/>
            <property name="jakarta.persistence.jdbc.user" value="cma"/>
            <property name="jakarta.persistence.jdbc.password" value="cma"/>

            <!-- HIBERNATE -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="true"/>
            <property name="hibernate.type" value="trace"/>


        </properties>
    </persistence-unit>
</persistence>
