<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cma.proyectocma.ui.controller.detalle.DetalleController">

    <VBox fx:id="contenedorAtributos"
          spacing="12"
          AnchorPane.topAnchor="16"
          AnchorPane.leftAnchor="16"
          AnchorPane.rightAnchor="16"
          AnchorPane.bottomAnchor="16">

        <!-- Los nodos dinámicos usarán estas clases -->
        <!-- detail-row / detail-key / detail-value -->

        <Button text="Guardar"
                onAction="#guardar"
                styleClass="button-guardar"/>

        <Button text="Cancelar"
                onAction="#cancelar"
                styleClass="button-cancelar"/>

    </VBox>

</AnchorPane>
