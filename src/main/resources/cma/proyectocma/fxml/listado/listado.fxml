<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cma.proyectocma.ui.controller.listado.ListadoController"
            styleClass="root">

    <!-- AppBar -->
    <top>
        <HBox spacing="16" styleClass="header">
            <Label text="INVENTARIO" styleClass="label-title"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- Contenido -->
    <center>
        <StackPane style="-fx-padding: 18;">
            <AnchorPane styleClass="card">
                <ListView fx:id="listaDtos"
                          AnchorPane.topAnchor="0"
                          AnchorPane.bottomAnchor="0"
                          AnchorPane.leftAnchor="0"
                          AnchorPane.rightAnchor="0"
                          styleClass="list-view"/>
            </AnchorPane>
        </StackPane>
    </center>

</BorderPane>
